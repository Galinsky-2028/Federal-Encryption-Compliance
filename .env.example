# Public preview only. Uses fictional self-contained data and bypasses operator configuration.
FDEA_DEMO_MODE=false

# Real-data access gate (required when demo mode is false): use HTTPS and
# provider-managed secrets. Pages and APIs return 503 until both are set
# (password at least 16 non-blank characters), then require HTTP Basic.
FDEA_ADMIN_USERNAME=
FDEA_ADMIN_PASSWORD=

CAIAE_API_BASE_URL=http://localhost:4000
# Optional until an organization is provisioned in the engine.
CAIAE_ORGANIZATION_ID=

# Server-side/operator provisioning only. Never expose this as public web config.
CAIAE_OPERATOR_TOKEN=

# Optional when reusing an already-created policy record.
FDEA_POLICY_ID=

# Leave unset while the source remains draft legislation.
# Live legal mode requires BOTH an enactment/effective timestamp and authority reference.
FDEA_EFFECTIVE_FROM=
FDEA_ENACTMENT_REFERENCE=


# Evaluation harness
FDEA_FIXTURE=fully-compliant-system
FDEA_EVALUATION_MODE=simulation
FDEA_REGISTERED_RULESET_ID=
FDEA_EVALUATED_AT=
FDEA_SYNC_FINDINGS=false
CAIAE_PRINCIPAL_ID=

# Contractor/external-system fixture harness
FDEA_PARTNER_FIXTURE=compliant-covered-contractor

# Opt-in: on startup in real-data mode, register the DRAFT policy bundle (never
# activated) and evaluate the fictional evaluation fixtures in simulation mode
# in the configured CAIAE tenant. Idempotent by fixture externalRef. Never in demo mode.
FDEA_PROVISION_DEMO_TENANT=false
